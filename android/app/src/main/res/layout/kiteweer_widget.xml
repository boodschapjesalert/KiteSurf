<?xml version="1.0" encoding="utf-8"?>
<!-- Startscherm-widget (KiteweerWidget.java): vaste kop, één pagina tegelijk (pagina 1 = het
     overzicht, daarna één pagina per dag met de grafiek) en onderaan pijltjes om te bladeren.
     Alleen RemoteViews-compatibele views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_grijs"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_spot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/widget_tekst"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Tikken = nu verversen. -->
        <TextView
            android:id="@+id/widget_bijgewerkt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="0dp"
            android:paddingBottom="2dp"
            android:textColor="@color/widget_tekst_zacht"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <include
            android:id="@+id/widget_overzicht"
            layout="@layout/kiteweer_widget_overzicht" />

        <include
            android:id="@+id/widget_dag"
            layout="@layout/kiteweer_widget_dag"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_leeg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_leeg"
            android:textColor="@color/widget_tekst"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bladeren: ‹ vorige · "Morgen · 3/6" · volgende › -->
    <LinearLayout
        android:id="@+id/widget_navigatie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_vorige"
            style="@style/KiteweerPijl"
            android:contentDescription="@string/widget_vorige"
            android:text="‹" />

        <TextView
            android:id="@+id/widget_pagina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_tekst_zacht"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_volgende"
            style="@style/KiteweerPijl"
            android:contentDescription="@string/widget_volgende"
            android:text="›" />
    </LinearLayout>
</LinearLayout>
